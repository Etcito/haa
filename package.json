{
  "name": "haa-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/haa"
  ],
  "scripts": {
    "build": "node scripts/build-wasm.mjs && npm run build -w @etcito/haa",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cargo test --workspace --quiet",
    "render": "cargo run -q --release -p haa-cli -- render",
    "inputs": "cargo run -q --release -p haa-cli -- inputs",
    "release:pack": "node scripts/release-pack.mjs",
    "render:node": "node packages/haa/dist/cli.js render",
    "test:host": "node --test packages/haa/test/",
    "listen": "node tools/listen/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
