{
  "name": "@etcito/haa",
  "version": "0.3.0",
  "description": "HAA procedural sound engine: Rust/wasm patches from HAA Studio played in the browser (AudioWorklet) and rendered offline in a Worker or Node.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Etcito/haa.git",
    "directory": "packages/haa"
  },
  "homepage": "https://github.com/Etcito/haa#readme",
  "bugs": {
    "url": "https://github.com/Etcito/haa/issues"
  },
  "keywords": ["audio", "procedural-audio", "sound-engine", "game-audio", "sfx", "webaudio", "audioworklet", "wasm", "webassembly", "speech", "haa"],
  "engines": {
    "node": ">=22.18"
  },
  "files": ["dist", "pkg", "README.md", "LICENSE"],
  "bin": {
    "haa-node": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./offline": {
      "types": "./dist/offline.d.ts",
      "default": "./dist/offline.js"
    },
    "./sfx": {
      "types": "./dist/sfx/index.d.ts",
      "default": "./dist/sfx.js"
    },
    "./bank": {
      "types": "./dist/bank.d.ts",
      "default": "./dist/bank.js"
    },
    "./arranger": {
      "types": "./dist/arranger.d.ts",
      "default": "./dist/arranger.js"
    },
    "./fit": {
      "types": "./dist/fit.d.ts",
      "default": "./dist/fit.js"
    },
    "./speech": {
      "types": "./dist/speech.d.ts",
      "default": "./dist/speech.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./worklet": "./dist/worklet.js",
    "./wasm": "./pkg/haa.wasm",
    "./field-wasm": "./pkg/haa-field.wasm",
    "./field-worker": "./dist/field-worker.js",
    "./bake-worker": "./dist/bake-worker.js",
    "./render-worker": "./dist/render-worker.js",
    "./mix-worker": "./dist/mix-worker.js",
    "./mix-wasm": "./pkg/haa-mix.wasm",
    "./trace-worker": "./dist/trace-worker.js",
    "./trace-wasm": "./pkg/haa-trace.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
