{
  "haa": 1,
  "id": "wood-crate-impact",
  "title": "Wood crate impact",
  "inputs": [
    { "name": "energy", "kind": "continuous", "unit": "", "min": 0, "max": 1, "default": 0.6, "smooth": 0, "curve": "lin" },
    { "name": "size", "kind": "continuous", "unit": "", "min": 0, "max": 1, "default": 0.5, "smooth": 0, "curve": "lin" },
    { "name": "hardness", "kind": "continuous", "unit": "", "min": 0, "max": 1, "default": 0.5, "smooth": 0, "curve": "lin" }
  ],
  "graph": {
    "duration": 1.6,
    "loop": false,
    "mode": "timeline",
    "nodes": [
      { "id": "in-energy", "type": "input", "label": "Energy", "x": 20, "y": 20, "params": { "name": "energy" } },
      { "id": "in-size", "type": "input", "label": "Size", "x": 20, "y": 120, "params": { "name": "size" } },
      { "id": "in-hardness", "type": "input", "label": "Hardness", "x": 20, "y": 220, "params": { "name": "hardness" } },

      { "id": "map-freq", "type": "map", "label": "Size -> box fundamental", "x": 220, "y": 120, "params": { "in": 0, "inMin": 0, "inMax": 1, "scale": "lin", "outMin": 200, "outMax": 5 } },
      { "id": "map-decay", "type": "map", "label": "Size -> ring decay", "x": 220, "y": 180, "params": { "in": 0, "inMin": 0, "inMax": 1, "scale": "lin", "outMin": 0.085, "outMax": 0.395 } },
      { "id": "map-rattle-freq", "type": "map", "label": "Size -> rattle band", "x": 220, "y": 240, "params": { "in": 0, "inMin": 0, "inMax": 1, "scale": "lin", "outMin": 3390, "outMax": 1190 } },

      { "id": "map-cutoff-hardness", "type": "map", "label": "Hardness -> knock cutoff", "x": 220, "y": 20, "params": { "in": 0, "inMin": 0, "inMax": 1, "scale": "lin", "outMin": 590, "outMax": 5190 } },

      { "id": "map-level-energy", "type": "map", "label": "Energy -> knock level", "x": 220, "y": 320, "params": { "in": 0, "inMin": 0, "inMax": 1, "scale": "lin", "outMin": 0.08, "outMax": 0.95 } },
      { "id": "map-color-energy", "type": "map", "label": "Energy -> ring color", "x": 220, "y": 380, "params": { "in": 0, "inMin": 0, "inMax": 1, "scale": "lin", "outMin": 0.5, "outMax": 0.78 } },
      { "id": "map-rattle-energy", "type": "map", "label": "Energy -> rattle amount", "x": 220, "y": 440, "params": { "in": 0, "inMin": 0, "inMax": 1, "scale": "lin", "outMin": 0.0, "outMax": 0.5 } },

      { "id": "knock", "type": "grain", "label": "Impact transient", "x": 460, "y": 20, "params": { "wave": "noise", "frequency": 1800, "resonance": 0.7, "rate": 0, "attack": 0.0006, "decay": 0.012, "spread": 0, "jitter": 0, "variation": 0.2, "glide": 0, "delay": 0, "width": 0.3, "level": 0 } },
      { "id": "knock-filter", "type": "filter", "label": "Transient brightness", "x": 680, "y": 20, "params": { "cutoff": 10, "resonance": 0.9, "mode": "bandpass" } },

      { "id": "body-resonator", "type": "resonator", "label": "Box body modes", "x": 900, "y": 20, "params": { "frequency": 80, "decay": 0.005, "color": 0.5, "mix": 0.92 } },
      { "id": "lid-resonator", "type": "resonator", "label": "Lid / panel modes", "x": 900, "y": 160, "params": { "frequency": 80, "decay": 0.005, "color": 0.8, "mix": 0.3 } },

      { "id": "rattle", "type": "grain", "label": "Loose slats rattle", "x": 460, "y": 320, "params": { "wave": "noise", "frequency": 1800, "resonance": 0.7, "rate": 45, "attack": 0.001, "decay": 0.006, "spread": 0, "jitter": 0.9, "variation": 0.7, "glide": 0, "delay": 0.05, "width": 0.5, "level": 0 } },
      { "id": "rattle-filter", "type": "filter", "label": "Rattle band", "x": 680, "y": 320, "params": { "cutoff": 10, "resonance": 0.8, "mode": "bandpass" } },
      { "id": "rattle-env", "type": "envelope", "label": "Rattle die-out", "x": 680, "y": 400, "params": { "attack": 0.002, "decay": 0.001, "sustain": 0, "hold": 0.02, "release": 0.05, "clock": "patch", "retrigger": 0 } },
      { "id": "rattle-gain", "type": "gain", "label": "Rattle envelope", "x": 900, "y": 320, "params": { "gain": 0 } },

      { "id": "mixbus", "type": "gain", "label": "Mix", "x": 1140, "y": 120, "params": { "gain": 1 } },
      { "id": "out", "type": "output", "label": "Output", "x": 1340, "y": 120, "params": { "gain": 1.0 } }
    ],
    "connections": [
      { "id": "e-size-freq", "from": "in-size", "to": "map-freq", "target": "in", "amount": 1 },
      { "id": "e-size-decay", "from": "in-size", "to": "map-decay", "target": "in", "amount": 1 },
      { "id": "e-size-rattlefreq", "from": "in-size", "to": "map-rattle-freq", "target": "in", "amount": 1 },
      { "id": "e-hardness-cutoff", "from": "in-hardness", "to": "map-cutoff-hardness", "target": "in", "amount": 1 },
      { "id": "e-energy-level", "from": "in-energy", "to": "map-level-energy", "target": "in", "amount": 1 },
      { "id": "e-energy-color", "from": "in-energy", "to": "map-color-energy", "target": "in", "amount": 1 },
      { "id": "e-energy-rattle", "from": "in-energy", "to": "map-rattle-energy", "target": "in", "amount": 1 },

      { "id": "e-level-knock", "from": "map-level-energy", "to": "knock", "target": "level", "amount": 1 },
      { "id": "e-cutoff-knockfilter", "from": "map-cutoff-hardness", "to": "knock-filter", "target": "cutoff", "amount": 1 },
      { "id": "e-knock-knockfilter", "from": "knock", "to": "knock-filter", "target": "audio", "amount": 1 },

      { "id": "e-freq-body", "from": "map-freq", "to": "body-resonator", "target": "frequency", "amount": 1 },
      { "id": "e-decay-body", "from": "map-decay", "to": "body-resonator", "target": "decay", "amount": 1 },
      { "id": "e-color-body", "from": "map-color-energy", "to": "body-resonator", "target": "color", "amount": 1 },
      { "id": "e-knockfilter-body", "from": "knock-filter", "to": "body-resonator", "target": "audio", "amount": 1 },

      { "id": "e-freq-lid", "from": "map-freq", "to": "lid-resonator", "target": "frequency", "amount": 2.4 },
      { "id": "e-decay-lid", "from": "map-decay", "to": "lid-resonator", "target": "decay", "amount": 0.5 },
      { "id": "e-knockfilter-lid", "from": "knock-filter", "to": "lid-resonator", "target": "audio", "amount": 0.6 },

      { "id": "e-rattle-level", "from": "map-rattle-energy", "to": "rattle", "target": "level", "amount": 1 },
      { "id": "e-rattlefreq-rattlefilter", "from": "map-rattle-freq", "to": "rattle-filter", "target": "cutoff", "amount": 1 },
      { "id": "e-rattle-rattlefilter", "from": "rattle", "to": "rattle-filter", "target": "audio", "amount": 1 },
      { "id": "e-decay-rattleenv", "from": "map-decay", "to": "rattle-env", "target": "decay", "amount": 0.7 },
      { "id": "e-rattleenv-rattlegain", "from": "rattle-env", "to": "rattle-gain", "target": "gain", "amount": 1.8 },
      { "id": "e-rattlefilter-rattlegain", "from": "rattle-filter", "to": "rattle-gain", "target": "audio", "amount": 1 },

      { "id": "e-body-mix", "from": "body-resonator", "to": "mixbus", "target": "audio", "amount": 1.3 },
      { "id": "e-lid-mix", "from": "lid-resonator", "to": "mixbus", "target": "audio", "amount": 1.1 },
      { "id": "e-knockfilter-mix", "from": "knock-filter", "to": "mixbus", "target": "audio", "amount": 0.2 },
      { "id": "e-rattlegain-mix", "from": "rattle-gain", "to": "mixbus", "target": "audio", "amount": 0.7 },

      { "id": "e-mix-out", "from": "mixbus", "to": "out", "target": "audio", "amount": 1 }
    ]
  },
  "master": 1
}
